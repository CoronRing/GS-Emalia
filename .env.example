# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# --- Mail account -----------------------------------------------------------
EMALIA_ADDRESS=assistant@gmail.com
# Most providers require an App Password, not your account password.
EMALIA_PASSWORD=
# gmail | outlook | yahoo | icloud | fastmail | zoho | proton
EMALIA_PROVIDER=gmail

# Explicit endpoints instead of (or overriding) a provider preset:
# EMALIA_IMAP_HOST=imap.example.com
# EMALIA_IMAP_PORT=993
# EMALIA_SMTP_HOST=smtp.example.com
# EMALIA_SMTP_PORT=587
# EMALIA_SMTP_SECURITY=starttls
# EMALIA_USERNAME=
# EMALIA_DISPLAY_NAME=Emalia

# --- Model ------------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Overrides for emalia.toml ----------------------------------------------
# EMALIA_INSTANCE_NAME=Emalia
# EMALIA_ALLOWED_SENDERS=you@example.com,*@mycompany.com
# EMALIA_TOOLSETS=email,file_read
# EMALIA_SANDBOX_ROOTS=/home/you/shared
# EMALIA_TOKEN=a-shared-secret-that-must-appear-in-the-subject
# EMALIA_POLL_INTERVAL=30
# EMALIA_MAX_REPLIES_PER_HOUR=30
# EMALIA_DRY_RUN=false

# --- End-to-end tests (contributors only) ------------------------------------
# A separate prefix on purpose: the e2e suite cannot read the variables above,
# so it can never run against a configured production mailbox by accident.
# See docs/e2e-testing.md.
# EMALIA_E2E=1
# EMALIA_E2E_ADDRESS=emalia-test@gmail.com
# EMALIA_E2E_PASSWORD=
# EMALIA_E2E_PROVIDER=gmail
# A second mailbox, for the full inbound round trip:
# EMALIA_E2E_PEER_ADDRESS=
# EMALIA_E2E_PEER_PASSWORD=
# EMALIA_E2E_PEER_PROVIDER=gmail
# EMALIA_E2E_LLM_PROVIDER=anthropic
# EMALIA_E2E_LLM_MODEL=claude-sonnet-4-6
# EMALIA_E2E_TIMEOUT=180
