# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# --- Mail account -----------------------------------------------------------
EMALIA_ADDRESS=assistant@gmail.com
# gmail | outlook | yahoo | icloud | fastmail | zoho | proton
EMALIA_PROVIDER=gmail

# Pick exactly one credential. Setting two is refused rather than silently
# resolved, because that is what a half-finished migration looks like.
# See docs/authentication.md.
#
# Each of these also accepts its standard Google name, so a machine already
# holding one needs no second copy: GOOGLE_APP_PASSWORD, GOOGLE_OAUTH_CLIENT_ID,
# GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_OAUTH_REFRESH_TOKEN,
# GOOGLE_SERVICE_ACCOUNT_FILE.

# 1. An App Password, not your account password. Simplest, does not expire, and
#    the right answer for a personal @gmail.com.
EMALIA_PASSWORD=

# 2. A service account key. THE ONE FOR A DEPLOYED SYSTEM: no expiry, no
#    browser at any point, and rotated with `gcloud` rather than by a person.
#    Needs a Google Workspace domain and one authorisation by an administrator.
#    Install the signing dependency with: pip install "emalia[gcp]"
# EMALIA_SERVICE_ACCOUNT_FILE=/etc/emalia/service-account.json
#    Or inline, for a secret store with no filesystem:
# EMALIA_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}

# 3. OAuth from a token file. Run `emalia auth google login`, or
#    `emalia auth microsoft login` for Outlook and Microsoft 365, then
#    uncomment this and clear EMALIA_PASSWORD above. Note that on an unverified
#    Google app the refresh token expires after seven days -- a poor fit for
#    anything unattended. Microsoft tokens are not subject to that limit.
# EMALIA_AUTH=oauth
# EMALIA_OAUTH_TOKEN_FILE=/explicit/path/if/not/the/default.json

# 4. The same OAuth grant supplied directly, for CI and containers where there
#    is no file to mount. `emalia auth <provider> login --print-env` prints these.
# EMALIA_OAUTH_CLIENT_ID=
# EMALIA_OAUTH_CLIENT_SECRET=
# EMALIA_OAUTH_REFRESH_TOKEN=
# Only for a non-Google provider. For Microsoft the token URI is
# https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
# EMALIA_OAUTH_TOKEN_URI=
# EMALIA_OAUTH_SCOPE=

# Explicit endpoints instead of (or overriding) a provider preset:
# EMALIA_IMAP_HOST=imap.example.com
# EMALIA_IMAP_PORT=993
# EMALIA_SMTP_HOST=smtp.example.com
# EMALIA_SMTP_PORT=587
# EMALIA_SMTP_SECURITY=starttls
# EMALIA_USERNAME=
# EMALIA_DISPLAY_NAME=Emalia

# --- Model ------------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Overrides for emalia.toml ----------------------------------------------
# EMALIA_INSTANCE_NAME=Emalia
# EMALIA_ALLOWED_SENDERS=you@example.com,*@mycompany.com
# EMALIA_TOOLSETS=email,file_read
# EMALIA_SANDBOX_ROOTS=/home/you/shared
# EMALIA_TOKEN=a-shared-secret-that-must-appear-in-the-subject
# EMALIA_POLL_INTERVAL=30
# EMALIA_MAX_REPLIES_PER_HOUR=30
# EMALIA_DRY_RUN=false

# --- End-to-end tests (contributors only) ------------------------------------
# A separate prefix on purpose: the e2e suite cannot read the variables above,
# so it can never run against a configured production mailbox by accident.
# See docs/e2e-testing.md.
# EMALIA_E2E=1
# EMALIA_E2E_ADDRESS=emalia-test@gmail.com
# EMALIA_E2E_PASSWORD=
# EMALIA_E2E_PROVIDER=gmail
# The suite accepts OAuth on the same terms, under its own prefix:
# EMALIA_E2E_AUTH=oauth
# EMALIA_E2E_OAUTH_CLIENT_ID=
# EMALIA_E2E_OAUTH_CLIENT_SECRET=
# EMALIA_E2E_OAUTH_REFRESH_TOKEN=
# A second mailbox, for the full inbound round trip:
# EMALIA_E2E_PEER_ADDRESS=
# EMALIA_E2E_PEER_PASSWORD=
# EMALIA_E2E_PEER_PROVIDER=gmail
# EMALIA_E2E_LLM_PROVIDER=anthropic
# EMALIA_E2E_LLM_MODEL=claude-sonnet-4-6
# EMALIA_E2E_TIMEOUT=180
